{
  "name": "project-together",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=24.3.0 <25"
  },
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build:web": "expo export --platform web",
    "build:ios:js": "expo export --platform ios --output-dir dist-ios",
    "preview": "node scripts/preview.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "test:components": "jest --config jest.config.cjs --runInBand",
    "review:start": "node scripts/review/start.mjs",
    "review:check": "node scripts/review/check.mjs"
  },
  "dependencies": {
    "expo": "~58.0.22",
    "expo-router": "~58.0.29",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-dom": "19.3.0",
    "react-native-web": "~0.21.4",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "expo-linking": "~58.0.15",
    "expo-constants": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "zod": "^4.0.0",
    "@expo/metro-runtime": "~58.0.16",
    "expo-dev-client": "~58.0.18"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "@types/react": "~19.3.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "prettier": "^3.0.0",
    "vitest": "^4.0.0",
    "@playwright/test": "^1.56.0",
    "@testing-library/react-native": "^14.1.0",
    "jest-expo": "~58.0.13",
    "jest": "~30.5.2",
    "@types/jest": "30.0.0",
    "test-renderer": "1.3.0"
  }
}
